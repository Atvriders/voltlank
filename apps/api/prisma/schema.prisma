generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Accounts and authentication
// ---------------------------------------------------------------------------

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String
  passwordHash     String
  role             String    @default("OWNER")
  emailVerifiedAt  DateTime? @db.Timestamptz(3)
  totpSecret       String?
  totpEnabled      Boolean   @default(false)
  timezone         String    @default("UTC")
  units            String    @default("metric")
  locale           String    @default("en-US")
  theme            String    @default("voltlank-dark")
  demoEnabled      Boolean   @default(false)
  presentationMode Boolean   @default(false)
  deletedAt        DateTime? @db.Timestamptz(3)
  createdAt        DateTime @db.Timestamptz(3)  @default(now())
  sessions         UserSession[]
  verifications    EmailVerification[]
  passwordResets   PasswordReset[]
  passkeys         PasskeyCredential[]
  providerAccounts ProviderAccount[]
  vehicles         Vehicle[]
  notifications    AppNotification[]
  preferences      NotificationPreference[]
  automations      Automation[]
  apiKeys          ApiKey[]
  webhooks         WebhookEndpoint[]
  pushSubs         PushSubscription[]
  auditEvents      AuditLog[]
}

model UserSession {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  ip         String?
  userAgent  String?
  label      String?
  createdAt  DateTime @db.Timestamptz(3)  @default(now())
  lastSeenAt DateTime? @db.Timestamptz(3)
  expiresAt  DateTime @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  @@index([userId])
}

model EmailVerification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  @@index([userId])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  @@index([userId])
}

model PasskeyCredential {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String   @unique
  publicKey    String
  counter      BigInt
  transports   Json     @default("[]")
  name         String
  createdAt    DateTime @db.Timestamptz(3) @default(now())
  @@index([userId])
}

model PasskeyChallenge {
  id        String   @id @default(cuid())
  userId    String
  challenge String
  type      String
  expiresAt DateTime @db.Timestamptz(3)
  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String?
  entityId   String?
  details    Json?
  ip         String?
  requestId  String?
  createdAt  DateTime @db.Timestamptz(3) @default(now())
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// Providers
// ---------------------------------------------------------------------------

model ProviderAccount {
  id         String             @id @default(cuid())
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   String
  label      String
  status     String             @default("pending")
  demo       Boolean            @default(false)
  scopes     Json               @default("[]")
  lastSyncAt DateTime? @db.Timestamptz(3)
  lastError  String?
  createdAt  DateTime @db.Timestamptz(3)           @default(now())
  credential ProviderCredential?
  vehicles   Vehicle[]
  @@index([userId])
}

model ProviderCredential {
  id                String          @id @default(cuid())
  providerAccountId String          @unique
  providerAccount   ProviderAccount @relation(fields: [providerAccountId], references: [id], onDelete: Cascade)
  keyVersion        Int
  algorithm         String
  ciphertext        String
  createdAt         DateTime @db.Timestamptz(3)        @default(now())
}

// ---------------------------------------------------------------------------
// Vehicles and telemetry
// ---------------------------------------------------------------------------

model Vehicle {
  id                String           @id @default(cuid())
  ownerId           String
  owner             User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  providerAccountId String
  providerAccount   ProviderAccount  @relation(fields: [providerAccountId], references: [id], onDelete: Cascade)
  provider          String
  providerVehicleId String
  displayName       String
  make              String?
  model             String?
  year              Int?
  vehicleClass      String           @default("fallback")
  exteriorColor     String           @default("#8b9bb4")
  wheelStyle        String?
  vinLast4          String?
  capabilities      Json             @default("[]")
  demo              Boolean          @default(false)
  active            Boolean          @default(true)
  createdAt         DateTime @db.Timestamptz(3)         @default(now())
  updatedAt         DateTime @db.Timestamptz(3)         @updatedAt
  snapshot          VehicleSnapshot?
  locations         VehicleLocation?
  drives            Drive[]
  chargeSessions    ChargingSession[]
  commands          VehicleCommand[]
  assignments       VehicleAssignment[]
  permissions       VehiclePermission[]
  maintenance       MaintenanceRecord[]
  groupLinks        FleetGroupVehicle[]
  aggregatesDaily   AggregateDaily[]
  aggregatesMonthly AggregateMonthly[]
  @@unique([provider, providerVehicleId, providerAccountId])
  @@index([ownerId])
}

model VehicleSnapshot {
  vehicleId String    @id
  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  state     Json
  fetchedAt DateTime @db.Timestamptz(3)
  freshness String    @default("last_known")
  updatedAt DateTime @db.Timestamptz(3)  @updatedAt
}

model VehicleLocation {
  vehicleId  String    @id
  vehicle    Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  ts         DateTime @db.Timestamptz(3)
  lat        Float
  lon        Float
  headingDeg Float?
  speedKmh   Float?
  accuracyM  Float?
  address    String?
}

// ---------------------------------------------------------------------------
// Places, geofences, privacy zones
// ---------------------------------------------------------------------------

model Place {
  id      String  @id @default(cuid())
  userId  String
  name    String
  type    String  @default("custom")
  lat     Float
  lon     Float
  radiusM Float   @default(100)
  @@index([userId])
}

model Geofence {
  id              String    @id @default(cuid())
  userId          String
  name            String
  lat             Float
  lon             Float
  radiusM         Float     @default(200)
  alertOn         String    @default("both")
  enabled         Boolean   @default(true)
  lastTriggeredAt DateTime? @db.Timestamptz(3)
  @@index([userId])
}

model PrivacyZone {
  id      String  @id @default(cuid())
  userId  String
  name    String
  lat     Float
  lon     Float
  radiusM Float   @default(300)
  enabled Boolean @default(true)
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Drives and charging
// ---------------------------------------------------------------------------

model Drive {
  id                String           @id @default(cuid())
  vehicleId         String
  vehicle           Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  startAt           DateTime @db.Timestamptz(3)
  endAt             DateTime @db.Timestamptz(3)
  startLat          Float?
  startLon          Float?
  startAddress      String?
  endLat            Float?
  endLon            Float?
  endAddress        String?
  distanceKm        Float
  durationSec       Int
  avgSpeedKmh       Float
  maxSpeedKmh       Float
  energyKwh         Float
  efficiencyWhPerKm Float
  estCost           Float?
  currency          String           @default("USD")
  elevationGainM    Float?
  avgOutsideTempC   Float?
  driverName        String?
  tags              Json             @default("[]")
  classification    String           @default("unknown")
  notes             String?
  routePoints       DriveRoutePoint[]
  @@index([vehicleId, startAt])
}

model DriveRoutePoint {
  id         String   @id @default(cuid())
  driveId    String
  drive      Drive    @relation(fields: [driveId], references: [id], onDelete: Cascade)
  seq        Int
  ts         DateTime @db.Timestamptz(3)
  lat        Float
  lon        Float
  speedKmh   Float
  headingDeg Float?
  batteryPct Float?
  @@index([driveId, seq])
}

model ChargingSession {
  id              String   @id @default(cuid())
  vehicleId       String
  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  startAt         DateTime @db.Timestamptz(3)
  endAt           DateTime? @db.Timestamptz(3)
  locationName    String?
  lat             Float?
  lon             Float?
  energyAddedKwh  Float    @default(0)
  batteryStartPct Float?
  batteryEndPct   Float?
  durationSec     Int      @default(0)
  avgPowerKw      Float    @default(0)
  peakPowerKw     Float    @default(0)
  cost            Float    @default(0)
  currency        String   @default("USD")
  source          String   @default("other")
  idleTimeSec     Int      @default(0)
  estLossKwh      Float    @default(0)
  notes           String?
  rateRuleId      String?
  rateName        String?
  pricePerKwh     Float?
  manualCost      Float?
  @@index([vehicleId, startAt])
}

model RateRule {
  id          String  @id @default(cuid())
  userId      String
  name        String
  type        String  @default("flat")
  pricePerKwh Float
  currency    String  @default("USD")
  periods     Json    @default("[]")
  placeId     String?
  enabled     Boolean @default(true)
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Automations and notifications
// ---------------------------------------------------------------------------

model Automation {
  id            String               @id @default(cuid())
  userId        String
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  enabled       Boolean              @default(true)
  vehicleId     String?
  triggerType   String
  triggerParams Json                 @default("{}")
  conditions    Json                 @default("[]")
  actions       Json                 @default("[]")
  cooldownSec   Int                  @default(0)
  maxRetries    Int                  @default(1)
  lastRunAt     DateTime? @db.Timestamptz(3)
  lastResult    String?
  runCount      Int                  @default(0)
  failureCount  Int                  @default(0)
  createdAt     DateTime @db.Timestamptz(3)             @default(now())
  executions    AutomationExecution[]
  @@index([userId])
}

model AutomationExecution {
  id            String     @id @default(cuid())
  automationId  String
  automation    Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  triggeredAt   DateTime @db.Timestamptz(3)   @default(now())
  triggerEvent  String?
  conditionsMet Boolean    @default(false)
  result        String     @default("skipped")
  actionResults Json       @default("[]")
  errorMessage  String?
  @@index([automationId, triggeredAt])
}

model AppNotification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event       String
  severity    String   @default("info")
  title       String
  body        String
  vehicleId   String?
  vehicleName String?
  channel     String   @default("in_app")
  readAt      DateTime? @db.Timestamptz(3)
  createdAt   DateTime @db.Timestamptz(3) @default(now())
  @@index([userId, readAt, createdAt])
}

model NotificationPreference {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel  String
  event    String
  severity String @default("info")
  enabled  Boolean @default(true)
  @@unique([userId, channel, event, severity])
}

model WebhookEndpoint {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  url            String
  secretHash     String?
  enabled        Boolean   @default(true)
  lastStatus     Int?
  lastDeliveryAt DateTime? @db.Timestamptz(3)
  @@index([userId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  keys      Json
  createdAt DateTime @db.Timestamptz(3) @default(now())
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Vehicle commands
// ---------------------------------------------------------------------------

model VehicleCommand {
  id                String             @id @default(cuid())
  vehicleId         String
  vehicle           Vehicle            @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vehicleName       String             @default("")
  providerAccountId String
  userId            String
  type              String
  params            Json               @default("{}")
  status            String             @default("queued")
  risk              String             @default("low")
  idempotencyKey    String             @unique
  confirmed         Boolean            @default(false)
  createdAt         DateTime @db.Timestamptz(3)           @default(now())
  submittedAt       DateTime? @db.Timestamptz(3)
  completedAt       DateTime? @db.Timestamptz(3)
  providerResponse  String?
  errorMessage      String?
  auditEvents       CommandAuditEvent[]
  @@index([vehicleId, createdAt])
  @@index([userId, createdAt])
}

model CommandAuditEvent {
  id        String         @id @default(cuid())
  commandId String
  command   VehicleCommand @relation(fields: [commandId], references: [id], onDelete: Cascade)
  event     String
  actor     String
  detail    String
  createdAt DateTime @db.Timestamptz(3)       @default(now())
  @@index([commandId, createdAt])
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  keyHash    String    @unique
  prefix     String
  scopes     Json      @default("[]")
  lastUsedAt DateTime? @db.Timestamptz(3)
  expiresAt  DateTime? @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  createdAt  DateTime @db.Timestamptz(3)  @default(now())
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Status platform
// ---------------------------------------------------------------------------

model StatusComponent {
  id             String       @id @default(cuid())
  key            String       @unique
  name           String
  group          String
  description    String?
  status         String       @default("unknown")
  manualOverride Boolean      @default(false)
  updatedAt      DateTime @db.Timestamptz(3)     @updatedAt
  checks         StatusCheck[]
}

model StatusCheck {
  id           String          @id @default(cuid())
  componentKey String
  component    StatusComponent @relation(fields: [componentKey], references: [key], onDelete: Cascade)
  at           DateTime @db.Timestamptz(3)        @default(now())
  ok           Boolean
  latencyMs    Int?
  detail       String?
  @@index([componentKey, at])
}

model Incident {
  id         String           @id @default(cuid())
  title      String
  severity   String           @default("minor")
  status     String           @default("investigating")
  phases     Json             @default("{}")
  components Json             @default("[]")
  public     Boolean          @default(true)
  createdAt  DateTime @db.Timestamptz(3)         @default(now())
  updates    IncidentUpdate[]
}

model IncidentUpdate {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  phase      String
  message    String
  author     String
  createdAt  DateTime @db.Timestamptz(3) @default(now())
  @@index([incidentId, createdAt])
}

model MaintenanceWindow {
  id          String   @id @default(cuid())
  title       String
  description String?
  startsAt    DateTime @db.Timestamptz(3)
  endsAt      DateTime @db.Timestamptz(3)
  components  Json     @default("[]")
  status      String   @default("scheduled")
}

model StatusSubscription {
  id        String    @id @default(cuid())
  email     String    @unique
  token     String    @unique
  confirmed Boolean   @default(false)
  createdAt DateTime @db.Timestamptz(3)  @default(now())
}

// ---------------------------------------------------------------------------
// Fleet management
// ---------------------------------------------------------------------------

model FleetGroup {
  id          String              @id @default(cuid())
  ownerId     String
  name        String
  description String?
  vehicles    FleetGroupVehicle[]
  @@index([ownerId])
}

model FleetGroupVehicle {
  fleetGroupId String
  vehicleId    String
  fleetGroup   FleetGroup @relation(fields: [fleetGroupId], references: [id], onDelete: Cascade)
  vehicle      Vehicle    @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  @@id([fleetGroupId, vehicleId])
}

model Department {
  id      String @id @default(cuid())
  ownerId String
  name    String
  @@index([ownerId])
}

model CostCenter {
  id      String @id @default(cuid())
  ownerId String
  name    String
  code    String
  @@index([ownerId])
}

model Driver {
  id      String  @id @default(cuid())
  ownerId String
  userId  String?
  name    String
  email   String?
  phone   String?
  active  Boolean @default(true)
  @@index([ownerId])
}

model VehicleAssignment {
  id           String     @id @default(cuid())
  ownerId      String
  vehicleId    String
  vehicle      Vehicle    @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driverId     String
  departmentId String?
  costCenterId String?
  fromAt       DateTime? @db.Timestamptz(3)
  toAt         DateTime? @db.Timestamptz(3)
  @@index([vehicleId])
  @@index([ownerId])
}

/// Per-vehicle access granted by the owner to another user.
model VehiclePermission {
  id        String  @id @default(cuid())
  ownerId   String
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  userId    String
  level     String  @default("viewer") // driver | viewer
  createdAt DateTime @db.Timestamptz(3) @default(now())
  @@unique([vehicleId, userId])
  @@index([userId])
}

model MaintenanceRecord {
  id            String   @id @default(cuid())
  vehicleId     String
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  title         String
  kind          String   @default("service")
  dueAt         DateTime? @db.Timestamptz(3)
  dueOdometerKm Float?
  completedAt   DateTime? @db.Timestamptz(3)
  cost          Float?
  currency      String   @default("USD")
  notes         String?
  @@index([vehicleId])
}

// ---------------------------------------------------------------------------
// Settings and aggregates
// ---------------------------------------------------------------------------

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @db.Timestamptz(3) @updatedAt
}

model AggregateDaily {
  id                 String   @id @default(cuid())
  vehicleId          String
  vehicle            Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  date               DateTime @db.Date
  distanceKm         Float    @default(0)
  energyKwh          Float    @default(0)
  chargeEnergyKwh    Float    @default(0)
  chargeCost         Float    @default(0)
  driveCount         Int      @default(0)
  chargeSessionCount Int      @default(0)
  minBatteryPct      Float?
  maxBatteryPct      Float?
  @@unique([vehicleId, date])
  @@index([date])
}

model AggregateMonthly {
  id                 String   @id @default(cuid())
  vehicleId          String
  vehicle            Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  month              DateTime @db.Date
  distanceKm         Float    @default(0)
  energyKwh          Float    @default(0)
  chargeEnergyKwh    Float    @default(0)
  chargeCost         Float    @default(0)
  driveCount         Int      @default(0)
  chargeSessionCount Int      @default(0)
  @@unique([vehicleId, month])
}

// ---------------------------------------------------------------------------
// Background jobs (Postgres queue implementation)
// ---------------------------------------------------------------------------

model BackgroundJob {
  id          String    @id @default(cuid())
  queue       String
  payload     String
  status      String    @default("pending")
  runAt       DateTime @db.Timestamptz(3)  @default(now())
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  lockedAt    DateTime? @db.Timestamptz(3)
  lockedBy    String?
  startedAt   DateTime? @db.Timestamptz(3)
  doneAt      DateTime? @db.Timestamptz(3)
  error       String?
  dedupeKey   String?
  @@index([queue, status, runAt])
  @@index([dedupeKey])
}

model DataRetentionJob {
  id          String   @id @default(cuid())
  kind        String
  ranAt       DateTime @db.Timestamptz(3) @default(now())
  rowsDeleted Int      @default(0)
  detail      String?
  @@index([kind, ranAt])
}
